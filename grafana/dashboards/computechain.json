  "panels": [
    {
      "id": 1,
      "title": "Узлы online",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "ds_prom"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(cpc_node_up)",
          "refId": "A",
          "legendFormat": "{{node}} {{quantile}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
